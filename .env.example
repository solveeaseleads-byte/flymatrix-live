
PORT=10000
NODE_ENV=production

FRONTEND_URL=https://YOUR-FLYMATRIX-FRONTEND.netlify.app

SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Flight provider
DUFFEL_API_KEY=
DUFFEL_API_BASE_URL=https://api.duffel.com
DUFFEL_API_VERSION=v2

# Future providers
FLIGHT_API_KEY=
FLIGHT_API_BASE_URL=

FX_API_KEY=
FX_API_BASE_URL=

PAYSTACK_SECRET_KEY=

# Optional protection
INTERNAL_API_KEY=

# Email notifications (Resend - https://resend.com)
RESEND_API_KEY=
RESEND_FROM=FlyMatrix <alerts@yourdomain.com>

# Telegram bot notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
