# =========================================================
# FLYMATRIX ENVIRONMENT
# =========================================================

NODE_ENV=development
PORT=3000

# =========================================================
# SUPABASE
# =========================================================

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# =========================================================
# TRAVELPAYOUTS — CENTRAL ACCOUNT
# =========================================================
#
# One Travelpayouts account/API token can authenticate
# Travelpayouts API requests.
#
# The marker identifies affiliate tracking.
#
# Keep these values server-side only.
# NEVER expose them through Vite or NEXT_PUBLIC_* variables.
#

TRAVELPAYOUTS_API_KEY=
TRAVELPAYOUTS_MARKER=

# Optional alternative token variable.
# Only use this if your existing deployment uses it.
TRAVELPAYOUTS_TOKEN=

# =========================================================
# TRAVELPAYOUTS — BRAND / PROGRAM TRS
# =========================================================
#
# TRS values identify the connected Travelpayouts
# brand/program when using the Partner Links API.
#
# Leave blank until the corresponding brand/program
# provides the correct TRS.
#

TRAVELPAYOUTS_AVIASALES_TRS=
TRAVELPAYOUTS_BOOKING_TRS=
TRAVELPAYOUTS_GETYOURGUIDE_TRS=
TRAVELPAYOUTS_AIRALO_TRS=
TRAVELPAYOUTS_AIRHELP_TRS=
TRAVELPAYOUTS_RADICAL_STORAGE_TRS=
TRAVELPAYOUTS_IVISA_TRS=

# =========================================================
# FLIGHTS
# =========================================================

# Existing flight-provider API credentials
# Keep only the providers actually configured.

DUFFEL_API_KEY=

# Existing Travelpayouts / Aviasales flight API
# can use the central TRAVELPAYOUTS_API_KEY above.

# =========================================================
# PAYSTACK
# =========================================================

PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# =========================================================
# EMAIL
# =========================================================

RESEND_API_KEY=
RESEND_FROM_EMAIL=

# =========================================================
# TELEGRAM
# =========================================================

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# =========================================================
# OPTIONAL SECURITY
# =========================================================

# Used by your deployment/platform if applicable.
# Do not place secrets in frontend variables.

SESSION_SECRET=
WEBHOOK_SECRET=
